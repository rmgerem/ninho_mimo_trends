# ============================================================
# .env.docker — Template de variaveis para deploy via Docker
#
# INSTRUCOES:
#   1. Copie este arquivo: cp .env.docker .env.docker.local
#   2. Edite .env.docker.local com suas credenciais reais
#   3. NUNCA cometa .env.docker.local no git (ja esta no .gitignore)
# ============================================================

# Ambiente da aplicacao
APP_ENV=PROD
LOG_LEVEL=INFO

# ---- Banco de dados PostgreSQL ----
# Obs.: DB_HOST NAO precisa ser alterado — o Docker resolve 'postgres'
# pelo nome do servico definido no docker-compose.yml.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ninho_mimo_trends
DB_USER=postgres
DB_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE
POSTGRES_HOST_PORT=5433

# ---- HTTP (coletores) ----
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=2
HTTP_USER_AGENT=NinhoMimoTrends/1.1

# ---- Shopee Affiliate Open API ----
# Obtenha em: https://affiliate.shopee.com.br/open_api
SHOPEE_AFFILIATE_APP_ID=SEU_APP_ID_AQUI
SHOPEE_AFFILIATE_SECRET=SEU_SECRET_AQUI

# ---- Grafana ----
GRAFANA_PORT=3000
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=SUBSTITUA_POR_SENHA_DO_GRAFANA

# ---- Prometheus / Observabilidade ----
PROMETHEUS_PORT=9090
# URL interna usada pelo scheduler para enviar metricas.
# Nao altere se estiver usando o docker-compose.yml padrao.
PROMETHEUS_PUSHGATEWAY_URL=http://pushgateway:9091
