# Copie este arquivo para ".env" e ajuste os valores para o seu ambiente.
# NUNCA cometa o arquivo ".env" real no controle de versao.

# Ambiente da aplicacao: DEV, TEST ou PROD
APP_ENV=DEV
LOG_LEVEL=INFO

# Banco de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ninho_mimo_trends
DB_USER=postgres
DB_PASSWORD=postgres

# Configuracoes de rede/HTTP para coletores
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_SECONDS=2
HTTP_USER_AGENT=NinhoMimoTrends/1.0

# Shopee Affiliate Open API (opcional; exige conta de afiliado Shopee ativa).
# Deixe em branco se nao for usar o coletor 'shopee_affiliate'.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
