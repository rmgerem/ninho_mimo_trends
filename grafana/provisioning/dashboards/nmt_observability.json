{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus - nmt",
      "description": "Data source Prometheus do Ninho & Mimo Trends.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "stat",
      "name": "Stat",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "timeseries",
      "name": "Time series",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "table",
      "name": "Table",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "gauge",
      "name": "Gauge",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "barchart",
      "name": "Bar chart",
      "version": "1.0.0"
    },
    {
      "type": "panel",
      "id": "text",
      "name": "Text",
      "version": "1.0.0"
    }
  ],
  "id": null,
  "uid": "nmt-observability",
  "title": "🔭 Ninho & Mimo Trends — Observabilidade do Scheduler",
  "description": "Saúde e desempenho do processo de coleta automática. Monitore se as coletas estão ocorrendo, quantos produtos foram encontrados e se há erros.",
  "tags": ["ninho-mimo-trends", "observabilidade", "scheduler", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m"]
  },
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Fonte",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nmt-prometheus"
        },
        "query": {
          "query": "label_values(nmt_collection_status, source)",
          "refId": "A"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "category",
        "label": "Categoria",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "nmt-prometheus"
        },
        "query": {
          "query": "label_values(nmt_collection_status, category)",
          "refId": "A"
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "## 🔭 Saúde do Scheduler\nMonitore se as coletas automáticas estão rodando, quantos produtos foram capturados e se há erros. **Verde = tudo ok. Vermelho = atenção imediata.**"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "⏰ Última coleta (há quanto tempo)",
      "description": "Tempo desde a última coleta concluída em qualquer fonte/categoria. Se passar de 4h sem atualizar, algo está errado.",
      "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 2 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10800 },
              { "color": "red", "value": 21600 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
          "expr": "time() - max(nmt_last_collection_timestamp_seconds{source=~\"$source\", category=~\"$category\"})",
          "legendFormat": "Tempo desde última coleta",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "✅ Status das coletas",
      "description": "Proporção de coletas bem-sucedidas na última rodada. 1.0 = todas ok, 0 = todas falharam.",
      "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 2 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.9 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
          "expr": "avg(nmt_collection_status{source=~\"$source\", category=~\"$category\"})",
          "legendFormat": "Status médio",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "📦 Produtos encontrados (última rodada)",
      "description": "Total de produtos encontrados na última coleta em todas as fontes/categorias selecionadas.",
      "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 2 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 10 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "graphMode": "area",
        "colorMode": "background",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
          "expr": "sum(nmt_items_found_last{source=~\"$source\", category=~\"$category\"})",
          "legendFormat": "Total encontrado",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "⚠️ Erros (última rodada)",
      "description": "Número de erros na última coleta. Qualquer valor acima de 0 merece atenção.",
      "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 2 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
          "expr": "sum(nmt_collection_errors_last{source=~\"$source\", category=~\"$category\"})",
          "legendFormat": "Total de erros",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "📈 Produtos encontrados ao longo do tempo",
      "description": "Evolução do número de produtos coletados por categoria. Quedas repentinas podem indicar mudanças na API ou bloqueio.",
      "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
          "expr": "nmt_items_found_last{source=~\"$source\", category=~\"$category\"}",
          "legendFormat": "{{source}} / {{category}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "⏱️ Duração das coletas (segundos)",
      "description": "Tempo de execução de cada coleta. Picos constantes podem indicar lentidão na API externa ou no banco.",
      "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "gradientMode": "none",
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
          "expr": "nmt_collection_duration_seconds_last{source=~\"$source\", category=~\"$category\"}",
          "legendFormat": "{{source}} / {{category}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "🆕 Produtos criados vs atualizados",
      "description": "Novos produtos (nunca vistos antes) vs produtos que já existiam e foram atualizados. Muitos 'criados' = mercado em expansão.",
      "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } },
              { "id": "custom.fillOpacity", "value": 5 }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
          "expr": "sum(nmt_items_created_last{source=~\"$source\", category=~\"$category\"})",
          "legendFormat": "🆕 Criados"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
          "expr": "sum(nmt_items_updated_last{source=~\"$source\", category=~\"$category\"})",
          "legendFormat": "🔄 Atualizados"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "⚠️ Erros ao longo do tempo",
      "description": "Histórico de erros de coleta. Picos de erro recorrentes no mesmo horário sugerem rate limit ou manutenção da API.",
      "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "none",
            "showPoints": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "sum"] }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
          "expr": "sum(nmt_collection_errors_last{source=~\"$source\", category=~\"$category\"}) by (source, category)",
          "legendFormat": "{{source}} / {{category}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "📋 Status por fonte e categoria (snapshot atual)",
      "description": "Estado atual de cada combinação fonte × categoria. Use para identificar rapidamente qual canal está com problema.",
      "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "left", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-background", "mode": "fixed" }
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "1": { "text": "✅ OK", "color": "green" } } },
                  { "type": "value", "options": { "0.5": { "text": "⚠️ Parcial", "color": "orange" } } },
                  { "type": "value", "options": { "0": { "text": "❌ Falhou", "color": "red" } } }
                ]
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Duração (s)" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "decimals", "value": 1 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 30 },
                    { "color": "red", "value": 60 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Encontrados" },
            "properties": [
              { "id": "unit", "value": "short" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "yellow", "value": 1 },
                    { "color": "green", "value": 5 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Erros" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 1 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Última coleta" },
            "properties": [
              { "id": "unit", "value": "dateTimeFromNow" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Status", "desc": false }]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
          "expr": "nmt_collection_status{source=~\"$source\", category=~\"$category\"}",
          "legendFormat": "status",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
          "expr": "nmt_items_found_last{source=~\"$source\", category=~\"$category\"}",
          "legendFormat": "found",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
          "expr": "nmt_collection_errors_last{source=~\"$source\", category=~\"$category\"}",
          "legendFormat": "errors",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
          "expr": "nmt_collection_duration_seconds_last{source=~\"$source\", category=~\"$category\"}",
          "legendFormat": "duration",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "E",
          "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
          "expr": "nmt_last_collection_timestamp_seconds{source=~\"$source\", category=~\"$category\"} * 1000",
          "legendFormat": "timestamp",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "source": "Fonte",
              "category": "Categoria",
              "Value #A": "Status",
              "Value #B": "Encontrados",
              "Value #C": "Erros",
              "Value #D": "Duração (s)",
              "Value #E": "Última coleta"
            },
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "barchart",
      "title": "🏆 Produtos indicados por categoria (última rodada)",
      "description": "Quantos produtos passaram pelo filtro de oportunidade (score ≥ 70) na última coleta, por categoria.",
      "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 29 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineWidth": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "category",
        "orientation": "vertical",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "nmt-prometheus" },
          "expr": "nmt_products_indicated_last{category=~\"$category\"}",
          "legendFormat": "{{category}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": { "category": "Categoria", "Value": "Indicações" },
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true }
          }
        }
      ]
    }
  ]
}
