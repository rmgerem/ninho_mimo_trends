      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Oportunidade",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "ninho-mimo-trends-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT pi.indicated_at AS \"Data\", p.normalized_name AS \"Produto\", c.name AS \"Categoria\", pi.opportunity_score AS \"Oportunidade\", pi.risk_score AS \"Risco\", pi.trend_status AS \"Tendência\", ps.current_price AS \"Preço (R$)\", ps.commission_rate AS \"Comissão %\", ps.seller_name AS \"Loja\", ps.affiliate_url AS \"Link Afiliado\", ps.image_url AS \"Imagem\" FROM tb_product_indications pi JOIN tb_products p ON p.id = pi.product_id JOIN tb_categories c ON c.id = pi.category_id LEFT JOIN tb_product_sources ps ON ps.product_id = p.id WHERE $__timeFilter(pi.indicated_at) ORDER BY pi.opportunity_score DESC, pi.indicated_at DESC LIMIT 200"
        }
      ]
    }
  ]
}