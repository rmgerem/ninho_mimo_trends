  "id": null,
  "uid": "ninho-mimo-trends-indicacoes",
  "title": "Ninho & Mimo Trends — Indicações da Automação",
  "description": "Quais produtos a automação indicou como oportunidade, e quando.",
  "tags": [
    "ninho-mimo-trends",
    "produtos",
    "automacao"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
