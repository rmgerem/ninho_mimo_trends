  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Sobre este dashboard",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Ninho & Mimo Trends — Indicações da automação.** Mostra quais produtos o sistema indicou (opportunity_score acima do limiar configurado em `configs/scoring_rules.json → indication.opportunity_threshold`) e quando, para orientar a produção de conteúdo. Use o seletor de período no topo (canto superior direito) para filtrar. Fonte dos dados: tabela `tb_product_indications` (ver `docs/database.md` e `docs/grafana.md`)."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Indicações no período",
      "description": "Total de eventos de indicação da automação no período/categorias selecionados.",
      "datasource": {
        "type": "postgres",
        "uid": "aftkqp1hx3x8ga"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "aftkqp1hx3x8ga"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS \"value\" FROM tb_product_indications pi JOIN tb_categories c ON c.id = pi.category_id WHERE $__timeFilter(pi.indicated_at)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Produtos únicos indicados",
      "description": "Quantidade de produtos distintos que receberam ao menos uma indicação no período.",
      "datasource": {
        "type": "postgres",
        "uid": "aftkqp1hx3x8ga"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "aftkqp1hx3x8ga"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT pi.product_id) AS \"value\" FROM tb_product_indications pi JOIN tb_categories c ON c.id = pi.category_id WHERE $__timeFilter(pi.indicated_at)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Opportunity Score médio",
      "description": "Média do opportunity_score entre as indicações do período (0–100).",
      "datasource": {
        "type": "postgres",
        "uid": "aftkqp1hx3x8ga"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 70
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "aftkqp1hx3x8ga"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT AVG(pi.opportunity_score) AS \"value\" FROM tb_product_indications pi JOIN tb_categories c ON c.id = pi.category_id WHERE $__timeFilter(pi.indicated_at)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Indicações de risco alto/crítico",
      "description": "Indicações cujo risk_score é HIGH (≥55) ou CRITICAL (≥75) — merecem atenção redobrada na moderação manual.",
      "datasource": {
        "type": "postgres",
        "uid": "aftkqp1hx3x8ga"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "aftkqp1hx3x8ga"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS \"value\" FROM tb_product_indications pi JOIN tb_categories c ON c.id = pi.category_id WHERE $__timeFilter(pi.indicated_at) AND pi.risk_score >= 55"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Indicações por dia",
      "description": "Quantidade de produtos indicados por dia, no período selecionado.",
      "datasource": {
        "type": "postgres",
        "uid": "aftkqp1hx3x8ga"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "aftkqp1hx3x8ga"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(pi.indicated_at, '1d') AS time, COUNT(*) AS \"Indicações\" FROM tb_product_indications pi JOIN tb_categories c ON c.id = pi.category_id WHERE $__timeFilter(pi.indicated_at) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 7,
      "type": "barchart",
      "title": "Indicações por categoria",
      "description": "Quantidade de indicações agrupadas por categoria de produto, no período selecionado.",
      "datasource": {
        "type": "postgres",
        "uid": "aftkqp1hx3x8ga"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "aftkqp1hx3x8ga"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.name AS \"Categoria\", COUNT(*) AS \"Indicações\" FROM tb_product_indications pi JOIN tb_categories c ON c.id = pi.category_id WHERE $__timeFilter(pi.indicated_at) GROUP BY c.name ORDER BY 2 DESC"
        }
      ]
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "Distribuição por nível de risco",
      "description": "Classificação de risco (LOW/MEDIUM/HIGH/CRITICAL) das indicações, usando os mesmos limiares de configs/scoring_rules.json (risk_score.thresholds).",
      "datasource": {
        "type": "postgres",
        "uid": "aftkqp1hx3x8ga"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "LOW"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "MEDIUM"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HIGH"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CRITICAL"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "aftkqp1hx3x8ga"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN pi.risk_score >= 75 THEN 'CRITICAL' WHEN pi.risk_score >= 55 THEN 'HIGH' WHEN pi.risk_score >= 30 THEN 'MEDIUM' ELSE 'LOW' END AS \"Nível de risco\", COUNT(*) AS \"Indicações\" FROM tb_product_indications pi JOIN tb_categories c ON c.id = pi.category_id WHERE $__timeFilter(pi.indicated_at) GROUP BY 1"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "🔥 Produtos indicados — copie o link e divulgue!",
      "description": "Lista dos melhores produtos indicados pela automação. Clique no link de afiliado para copiar e divulgar. Ordenado por Oportunidade (maior = melhor).",
      "datasource": {
        "type": "postgres",
        "uid": "ninho-mimo-trends-postgres"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
