      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "inlineEditing": false, "panZoom": false, "showAdvancedTypes": false, "zoomToContent": false, "tooltip": { "mode": "single" }, "root": { "name": "Element 1", "type": "frame", "elements": [
        { "name": "Foto", "type": "rectangle", "constraint": { "horizontal": "leftright", "vertical": "topbottom" }, "placement": { "left": 0, "right": 0, "top": 0, "bottom": 0 }, "background": { "color": { "fixed": "transparent" }, "image": { "mode": "field", "field": "Imagem", "fixed": "" }, "size": "cover" }, "border": { "radius": 8, "width": 0 }, "links": [ { "title": "Abrir produto com meu link afiliado", "url": "http://localhost:8000/go?product_id=${__data.fields.ID}&user=${__user.login}", "targetBlank": true, "oneClick": true } ], "connections": [] },
        { "name": "Produto", "type": "text", "constraint": { "horizontal": "leftright", "vertical": "bottom" }, "placement": { "left": 0, "right": 0, "bottom": 0, "height": 52 }, "background": { "color": { "fixed": "rgba(0, 0, 0, 0.72)" } }, "config": { "text": { "mode": "field", "field": "Produto", "fixed": "" }, "align": "center", "valign": "middle", "color": { "fixed": "#FFFFFF" }, "size": 15 }, "links": [ { "title": "Abrir produto com meu link afiliado", "url": "http://localhost:8000/go?product_id=${__data.fields.ID}&user=${__user.login}", "targetBlank": true, "oneClick": true } ], "connections": [] }
      ] } },
      "targets": [ { "refId": "A", "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" }, "format": "table", "rawQuery": true, "rawSql": "WITH latest AS (SELECT DISTINCT ON (product_id) product_id, opportunity_score, indicated_at FROM tb_product_indications WHERE $__timeFilter(indicated_at) ORDER BY product_id, indicated_at DESC), ranked AS (SELECT p.id, p.normalized_name, pi.opportunity_score, pi.indicated_at, offer.image_url FROM latest pi JOIN tb_products p ON p.id = pi.product_id JOIN LATERAL (SELECT ps.image_url FROM tb_product_sources ps JOIN tb_sources s ON s.id = ps.source_id WHERE ps.product_id = p.id AND s.code = 'shopee_affiliate' AND ps.image_url IS NOT NULL AND ps.original_url IS NOT NULL ORDER BY ps.commission_rate DESC NULLS LAST, ps.collected_at DESC LIMIT 1) offer ON true) SELECT id AS \"ID\", image_url AS \"Imagem\", normalized_name AS \"Produto\" FROM ranked ORDER BY opportunity_score DESC, indicated_at DESC LIMIT 1 OFFSET 1" } ]
    },
    {
      "id": 5,
      "type": "canvas",
      "title": "🥉 Top 3",
      "description": "Clique na foto ou no nome para gerar seu link afiliado.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "inlineEditing": false, "panZoom": false, "showAdvancedTypes": false, "zoomToContent": false, "tooltip": { "mode": "single" }, "root": { "name": "Element 1", "type": "frame", "elements": [
        { "name": "Foto", "type": "rectangle", "constraint": { "horizontal": "leftright", "vertical": "topbottom" }, "placement": { "left": 0, "right": 0, "top": 0, "bottom": 0 }, "background": { "color": { "fixed": "transparent" }, "image": { "mode": "field", "field": "Imagem", "fixed": "" }, "size": "cover" }, "border": { "radius": 8, "width": 0 }, "links": [ { "title": "Abrir produto com meu link afiliado", "url": "http://localhost:8000/go?product_id=${__data.fields.ID}&user=${__user.login}", "targetBlank": true, "oneClick": true } ], "connections": [] },
        { "name": "Produto", "type": "text", "constraint": { "horizontal": "leftright", "vertical": "bottom" }, "placement": { "left": 0, "right": 0, "bottom": 0, "height": 52 }, "background": { "color": { "fixed": "rgba(0, 0, 0, 0.72)" } }, "config": { "text": { "mode": "field", "field": "Produto", "fixed": "" }, "align": "center", "valign": "middle", "color": { "fixed": "#FFFFFF" }, "size": 15 }, "links": [ { "title": "Abrir produto com meu link afiliado", "url": "http://localhost:8000/go?product_id=${__data.fields.ID}&user=${__user.login}", "targetBlank": true, "oneClick": true } ], "connections": [] }
      ] } },
      "targets": [ { "refId": "A", "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" }, "format": "table", "rawQuery": true, "rawSql": "WITH latest AS (SELECT DISTINCT ON (product_id) product_id, opportunity_score, indicated_at FROM tb_product_indications WHERE $__timeFilter(indicated_at) ORDER BY product_id, indicated_at DESC), ranked AS (SELECT p.id, p.normalized_name, pi.opportunity_score, pi.indicated_at, offer.image_url FROM latest pi JOIN tb_products p ON p.id = pi.product_id JOIN LATERAL (SELECT ps.image_url FROM tb_product_sources ps JOIN tb_sources s ON s.id = ps.source_id WHERE ps.product_id = p.id AND s.code = 'shopee_affiliate' AND ps.image_url IS NOT NULL AND ps.original_url IS NOT NULL ORDER BY ps.commission_rate DESC NULLS LAST, ps.collected_at DESC LIMIT 1) offer ON true) SELECT id AS \"ID\", image_url AS \"Imagem\", normalized_name AS \"Produto\" FROM ranked ORDER BY opportunity_score DESC, indicated_at DESC LIMIT 1 OFFSET 2" } ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "🛒 Todos os Produtos em Alta",
      "description": "Lista das 100 melhores oportunidades. Use o filtro de categoria no topo do dashboard.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" },
      "gridPos": { "h": 15, "w": 24, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Oportunidade" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 40 },
                { "color": "yellow", "value": 55 },
                { "color": "green", "value": 70 }
              ] } },
              { "id": "decimals", "value": 0 },
              { "id": "custom.align", "value": "center" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Preço" },
            "properties": [
              { "id": "unit", "value": "currencyBRL" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.align", "value": "right" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Comissão %" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 5 },
                { "color": "green", "value": 10 }
              ] } },
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.align", "value": "center" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Tendência" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "GROWING_FAST": { "text": "🔥 Crescendo muito", "color": "red" } } },
                { "type": "value", "options": { "GROWING": { "text": "📈 Crescendo", "color": "orange" } } },
                { "type": "value", "options": { "STABLE": { "text": "➖ Estável", "color": "blue" } } },
                { "type": "value", "options": { "DECLINING": { "text": "📉 Caindo", "color": "purple" } } },
                { "type": "value", "options": { "NEW": { "text": "✨ Novo", "color": "green" } } }
              ] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Link Afiliado" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "auto" } },
              { "id": "links", "value": [ { "title": "Gerar Link Afiliado", "url": "http://localhost:8000/go?product_id=${__data.fields.ID}&user=${__user.login}", "targetBlank": true } ] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "ID" },
            "properties": [
              { "id": "custom.hidden", "value": true }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "AffiliateURL" },
            "properties": [
              { "id": "custom.hidden", "value": true }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Imagem" },
            "properties": [
              { "id": "links", "value": [ { "title": "🖼️ Ver Foto", "url": "${__value.text}", "targetBlank": true } ] }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [ { "displayName": "Oportunidade", "desc": true } ],
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT DISTINCT ON (product_id) product_id, category_id, opportunity_score, trend_status, indicated_at FROM tb_product_indications WHERE $__timeFilter(indicated_at) ORDER BY product_id, indicated_at DESC) SELECT p.id AS \"ID\", p.normalized_name AS \"Produto\", c.name AS \"Categoria\", pi.opportunity_score AS \"Oportunidade\", pi.trend_status AS \"Tendência\", ps.current_price AS \"Preço\", ps.commission_rate AS \"Comissão %\", ps.seller_name AS \"Loja\", 'Abrir oferta' AS \"Link Afiliado\", ps.affiliate_url AS \"AffiliateURL\", ps.image_url AS \"Imagem\" FROM latest pi JOIN tb_products p ON p.id = pi.product_id JOIN tb_categories c ON c.id = pi.category_id JOIN LATERAL (SELECT offer.current_price, offer.commission_rate, offer.seller_name, offer.affiliate_url, offer.image_url FROM tb_product_sources offer JOIN tb_sources source ON source.id = offer.source_id WHERE offer.product_id = p.id AND source.code = 'shopee_affiliate' AND offer.affiliate_url IS NOT NULL ORDER BY offer.commission_rate DESC NULLS LAST, offer.collected_at DESC LIMIT 1) ps ON true WHERE c.name ~ '${categoria:regex}' ORDER BY pi.opportunity_score DESC, pi.indicated_at DESC LIMIT 100"
        }
      ]
    }
  ]
}
