  ],
  "id": null,
  "uid": "nmt-cliente",
  "title": "🌟 Ninho & Mimo Trends",
  "description": "Os melhores produtos em alta para você divulgar hoje.",
  "tags": ["cliente", "ninho-mimo", "afiliado"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 11,
  "editable": false,
  "graphTooltip": 0,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {
    "hidden": false,
    "refresh_intervals": ["5m", "15m", "30m", "1h"]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 4, "w": 18, "x": 0, "y": 0 },
      "options": {
        "mode": "html",
        "content": "<div style=\"background: linear-gradient(135deg, #FF9A9E 0%, #FECFEF 99%, #FECFEF 100%); border-radius: 12px; padding: 24px; color: #333; height: 100%; display: flex; flex-direction: column; justify-content: center;\">\n  <h1 style=\"margin: 0; font-size: 32px; font-weight: 800; letter-spacing: -0.5px; color: #8C224B;\">🐣 Ninho & Mimo Trends</h1>\n  <p style=\"margin: 8px 0 0 0; font-size: 16px; opacity: 0.85; font-weight: 500; color: #A63C65;\">Os produtos que estão viralizando agora. Seu trabalho é só copiar e vender.</p>\n</div>"
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "text",
      "title": "",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "options": {
        "mode": "html",
        "content": "<div style=\"background: #1E1E2D; border: 1px solid #333; border-radius: 12px; padding: 16px; color: #E0E0E0; height: 100%;\">\n  <h3 style=\"margin: 0 0 8px 0; font-size: 14px; color: #FFA07A; text-transform: uppercase; letter-spacing: 1px;\">Como usar</h3>\n  <ol style=\"margin: 0; padding-left: 20px; font-size: 13px; line-height: 1.5;\">\n    <li>Escolha um produto abaixo</li>\n    <li>Clique em <b>Link Afiliado</b></li>\n    <li>Publique nos seus stories/grupos</li>\n  </ol>\n</div>"
      },
      "transparent": true
    },
    {
      "id": 3,
      "type": "stat",
      "title": "🏆 Top 1 — Melhor Oportunidade do Dia",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "green" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^Produto$/" },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT DISTINCT ON (product_id) product_id, opportunity_score, indicated_at FROM tb_product_indications WHERE $__timeFilter(indicated_at) ORDER BY product_id, indicated_at DESC) SELECT p.normalized_name AS \"Produto\" FROM latest pi JOIN tb_products p ON p.id = pi.product_id ORDER BY pi.opportunity_score DESC, pi.indicated_at DESC LIMIT 1 OFFSET 0"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "🥈 Top 2",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^Produto$/" },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT DISTINCT ON (product_id) product_id, opportunity_score, indicated_at FROM tb_product_indications WHERE $__timeFilter(indicated_at) ORDER BY product_id, indicated_at DESC) SELECT p.normalized_name AS \"Produto\" FROM latest pi JOIN tb_products p ON p.id = pi.product_id ORDER BY pi.opportunity_score DESC, pi.indicated_at DESC LIMIT 1 OFFSET 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "🥉 Top 3",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "super-light-yellow" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "super-light-yellow", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/^Produto$/" },
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "auto",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT DISTINCT ON (product_id) product_id, opportunity_score, indicated_at FROM tb_product_indications WHERE $__timeFilter(indicated_at) ORDER BY product_id, indicated_at DESC) SELECT p.normalized_name AS \"Produto\" FROM latest pi JOIN tb_products p ON p.id = pi.product_id ORDER BY pi.opportunity_score DESC, pi.indicated_at DESC LIMIT 1 OFFSET 2"
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "🛒 Todos os Produtos em Alta",
      "description": "Lista completa das melhores oportunidades. Os mais quentes estão no topo.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" },
      "gridPos": { "h": 15, "w": 24, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" } }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Oportunidade" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 40 },
                { "color": "yellow", "value": 55 },
                { "color": "green", "value": 70 }
              ] } },
              { "id": "decimals", "value": 0 },
              { "id": "custom.align", "value": "center" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Preço" },
            "properties": [
              { "id": "unit", "value": "currencyBRL" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.align", "value": "right" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Comissão %" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 5 },
                { "color": "green", "value": 10 }
              ] } },
              { "id": "unit", "value": "percent" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.align", "value": "center" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Tendência" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              { "id": "mappings", "value": [
                { "type": "value", "options": { "GROWING_FAST": { "text": "🔥 Crescendo muito", "color": "red" } } },
                { "type": "value", "options": { "GROWING": { "text": "📈 Crescendo", "color": "orange" } } },
                { "type": "value", "options": { "STABLE": { "text": "➖ Estável", "color": "blue" } } },
                { "type": "value", "options": { "DECLINING": { "text": "📉 Caindo", "color": "purple" } } },
                { "type": "value", "options": { "NEW": { "text": "✨ Novo", "color": "green" } } }
              ] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Link Afiliado" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "auto" } },
              { "id": "links", "value": [ { "title": "Abrir Link Afiliado", "url": "${__data.fields.AffiliateURL}", "targetBlank": true } ] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "ID" },
            "properties": [
              { "id": "custom.hidden", "value": true }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "AffiliateURL" },
            "properties": [
              { "id": "custom.hidden", "value": true }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Imagem" },
            "properties": [
              { "id": "links", "value": [ { "title": "🖼️ Ver Foto", "url": "${__value.text}", "targetBlank": true } ] }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [ { "displayName": "Oportunidade", "desc": true } ],
        "cellHeight": "sm"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest AS (SELECT DISTINCT ON (product_id) product_id, category_id, opportunity_score, trend_status, indicated_at FROM tb_product_indications WHERE $__timeFilter(indicated_at) ORDER BY product_id, indicated_at DESC) SELECT p.id AS \"ID\", p.normalized_name AS \"Produto\", c.name AS \"Categoria\", pi.opportunity_score AS \"Oportunidade\", pi.trend_status AS \"Tendência\", ps.current_price AS \"Preço\", ps.commission_rate AS \"Comissão %\", ps.seller_name AS \"Loja\", 'Abrir oferta' AS \"Link Afiliado\", ps.affiliate_url AS \"AffiliateURL\", ps.image_url AS \"Imagem\" FROM latest pi JOIN tb_products p ON p.id = pi.product_id JOIN tb_categories c ON c.id = pi.category_id JOIN LATERAL (SELECT offer.current_price, offer.commission_rate, offer.seller_name, offer.affiliate_url, offer.image_url FROM tb_product_sources offer JOIN tb_sources source ON source.id = offer.source_id WHERE offer.product_id = p.id AND source.code = 'shopee_affiliate' AND offer.affiliate_url IS NOT NULL ORDER BY offer.commission_rate DESC NULLS LAST, offer.collected_at DESC LIMIT 1) ps ON true ORDER BY pi.opportunity_score DESC, pi.indicated_at DESC LIMIT 100"
        }
      ]
    }
  ]
}
