  "id": null,
  "uid": "nmt-cliente",
  "title": "🌟 Ninho & Mimo Trends",
  "description": "Os melhores produtos em alta para você divulgar hoje.",
  "tags": ["cliente", "ninho-mimo", "afiliado"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 17,
  "editable": false,
  "graphTooltip": 0,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {
    "hidden": false,
    "refresh_intervals": ["1m", "5m", "15m", "30m", "1h"]
  },
  "templating": {
    "list": [
      {
        "name": "categoria",
        "label": "Filtrar tabela por categoria",
        "type": "query",
        "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" },
        "query": "SELECT DISTINCT c.name AS __text, c.name AS __value FROM tb_categories c JOIN tb_product_indications pi ON pi.category_id = c.id ORDER BY c.name",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "refresh": 1,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 4, "w": 18, "x": 0, "y": 0 },
      "options": {
        "mode": "html",
        "content": "<div style=\"background: linear-gradient(135deg, #FF9A9E 0%, #FECFEF 99%, #FECFEF 100%); border-radius: 12px; padding: 24px; color: #333; height: 100%; display: flex; flex-direction: column; justify-content: center;\">\n  <h1 style=\"margin: 0; font-size: 32px; font-weight: 800; letter-spacing: -0.5px; color: #8C224B;\">🐣 Ninho & Mimo Trends</h1>\n  <p style=\"margin: 8px 0 0 0; font-size: 16px; opacity: 0.85; font-weight: 500; color: #A63C65;\">Os produtos que estão viralizando agora. Seu trabalho é só copiar e vender.</p>\n</div>"
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "text",
      "title": "",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "options": {
        "mode": "html",
        "content": "<div style=\"background: #1E1E2D; border: 1px solid #333; border-radius: 12px; padding: 16px; color: #E0E0E0; height: 100%;\">\n  <h3 style=\"margin: 0 0 8px 0; font-size: 14px; color: #FFA07A; text-transform: uppercase; letter-spacing: 1px;\">Como usar</h3>\n  <ol style=\"margin: 0; padding-left: 20px; font-size: 13px; line-height: 1.5;\">\n    <li>Escolha um produto abaixo</li>\n    <li>Clique em <b>Link Afiliado</b></li>\n    <li>Publique nos seus stories/grupos</li>\n  </ol>\n</div>"
      },
      "transparent": true
    },
    {
      "id": 3,
      "type": "canvas",
      "title": "🏆 Top 1 — Melhor Oportunidade",
      "description": "Foto e nome do produto real com maior oportunidade. Clique para gerar seu link afiliado.",
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "inlineEditing": false, "panZoom": false, "showAdvancedTypes": false, "zoomToContent": false, "tooltip": { "mode": "single" }, "root": { "name": "Element 1", "type": "frame", "elements": [
        { "name": "Foto", "type": "rectangle", "constraint": { "horizontal": "leftright", "vertical": "topbottom" }, "placement": { "left": 0, "right": 0, "top": 0, "bottom": 0 }, "background": { "color": { "fixed": "transparent" }, "image": { "mode": "field", "field": "Imagem", "fixed": "" }, "size": "cover" }, "border": { "radius": 8, "width": 0 }, "links": [ { "title": "Abrir produto com meu link afiliado", "url": "http://localhost:8000/go?product_id=${__data.fields.ID}&user=${__user.login}", "targetBlank": true, "oneClick": true } ], "connections": [] },
        { "name": "Produto", "type": "text", "constraint": { "horizontal": "leftright", "vertical": "bottom" }, "placement": { "left": 0, "right": 0, "bottom": 0, "height": 52 }, "background": { "color": { "fixed": "rgba(0, 0, 0, 0.72)" } }, "config": { "text": { "mode": "field", "field": "Produto", "fixed": "" }, "align": "center", "valign": "middle", "color": { "fixed": "#FFFFFF" }, "size": 15 }, "links": [ { "title": "Abrir produto com meu link afiliado", "url": "http://localhost:8000/go?product_id=${__data.fields.ID}&user=${__user.login}", "targetBlank": true, "oneClick": true } ], "connections": [] }
      ] } },
      "targets": [ { "refId": "A", "datasource": { "type": "grafana-postgresql-datasource", "uid": "ninho-mimo-trends-postgres" }, "format": "table", "rawQuery": true, "rawSql": "WITH latest AS (SELECT DISTINCT ON (product_id) product_id, opportunity_score, indicated_at FROM tb_product_indications WHERE $__timeFilter(indicated_at) ORDER BY product_id, indicated_at DESC), ranked AS (SELECT p.id, p.normalized_name, pi.opportunity_score, pi.indicated_at, offer.image_url FROM latest pi JOIN tb_products p ON p.id = pi.product_id JOIN LATERAL (SELECT ps.image_url FROM tb_product_sources ps JOIN tb_sources s ON s.id = ps.source_id WHERE ps.product_id = p.id AND s.code = 'shopee_affiliate' AND ps.image_url IS NOT NULL AND ps.original_url IS NOT NULL ORDER BY ps.commission_rate DESC NULLS LAST, ps.collected_at DESC LIMIT 1) offer ON true) SELECT id AS \"ID\", image_url AS \"Imagem\", normalized_name AS \"Produto\" FROM ranked ORDER BY opportunity_score DESC, indicated_at DESC LIMIT 1 OFFSET 0" } ]
    },
    {
      "id": 4,
      "type": "canvas",
